# Copy this file to local.properties and fill in your values.
# local.properties is git-ignored, so your secrets never reach the repo.
#
# Android Studio adds the sdk.dir line to local.properties automatically;
# you don't need to copy it here.

# Gmail account to send from.
# IMPORTANT: use an "app password" (not your normal password).
# Create it in your Google Account: Security -> 2-Step Verification -> App passwords.
forwarder.smtpUser=
forwarder.smtpPassword=

# Where to forward SMS to.
forwarder.forwardTo=

# The target SIM is chosen in the app (by slot), not configured here.

# Optional (defaults shown):
# forwarder.smtpHost=smtp.gmail.com
# forwarder.smtpPort=587

# Release signing (optional; without it the release build is unsigned).
# Create a keystore with:
#   keytool -genkeypair -v -keystore keystore/release.jks -storetype PKCS12 \
#     -alias release -keyalg RSA -keysize 2048 -validity 10000
# forwarder.storeFile=keystore/release.jks
# forwarder.storePassword=your-store-password
# forwarder.keyAlias=release
# forwarder.keyPassword=your-key-password
